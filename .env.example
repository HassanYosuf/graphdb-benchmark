# Copy this file to .env and fill in your own credentials.
# .env is gitignored -- never commit real secrets.

# --- CognoDB Cloud (free c0 instance) ---
# From console.cognodb.com after creating your instance.
COGNODB_URI=bolt+s://your-instance-id.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# --- Neo4j AuraDB Free ---
# From console.neo4j.io after creating a Free instance.
NEO4J_AURA_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_AURA_USER=neo4j
NEO4J_AURA_PASSWORD=

# --- Memgraph (self-hosted via docker-compose, capped to CognoDB's specs) ---
# No signup needed -- `docker compose up memgraph` and use these defaults.
MEMGRAPH_URI=bolt://localhost:7688
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# --- Neo4j Community (self-hosted via docker-compose, capped to CognoDB's specs) ---
# No signup needed -- `docker compose up neo4j-community`.
NEO4J_COMMUNITY_URI=bolt://localhost:7687
NEO4J_COMMUNITY_USER=neo4j
NEO4J_COMMUNITY_PASSWORD=benchmarkpass123

# --- ArangoDB Oasis (free trial) ---
# From dashboard.arangodb.cloud after creating a trial deployment.
ARANGO_URL=https://your-deployment.arangodb.cloud:8529
ARANGO_USER=root
ARANGO_PASSWORD=
ARANGO_DB=benchmark

# --- FalkorDB Cloud (free tier) ---
# From app.falkordb.com after creating a free instance. Use the exact
# host:port shown on the instance's "Connect" page. FalkorDB Cloud instances
# use plain (non-TLS) Redis protocol and the ACL username "falkordb" (not
# "default") -- leave FALKOR_USER as-is unless your dashboard says otherwise.
FALKOR_HOST=your-instance.falkordb.io
FALKOR_PORT=6379
FALKOR_USER=falkordb
FALKOR_PASSWORD=
FALKOR_GRAPH=benchmark
